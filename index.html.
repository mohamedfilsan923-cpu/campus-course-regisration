
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Campus Course Registration</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <header>
        <h1>Campus Course Registration</h1>
        <p>Explore courses and register for your preferred subject.</p>
    </header>

    <main>
        <section id="courses">
            <h2>Available Courses</h2>

            <table>
                <thead>
                    <tr>
                        <th>Course Code</th>
                        <th>Course Name</th>
                        <th>Duration</th>
                        <th>Fee (KES)</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>CS101</td>
                        <td>Introduction to Computing</td>
                        <td>3 Months</td>
                        <td>15,000</td>
                    </tr>
                    <tr>
                        <td>WD102</td>
                        <td>Web Development</td>
                        <td>4 Months</td>
                        <td>20,000</td>
                    </tr>
                    <tr>
                        <td>DB103</td>
                        <td>Database Management</td>
                        <td>3 Months</td>
                        <td>18,000</td>
                    </tr>
                    <tr>
                        <td>NT104</td>
                        <td>Computer Networking</td>
                        <td>4 Months</td>
                        <td>22,000</td>
                    </tr>
                    <tr>
                        <td>CY105</td>
                        <td>Cybersecurity Basics</td>
                        <td>3 Months</td>
                        <td>19,000</td>
                    </tr>
                </tbody>
            </table>
        </section>

        <section id="registration">
            <h2>Course Registration Form</h2>

            <form action="#" method="get">
                <label for="student-name">Full Name</label>
                <input type="text" id="student-name"
                       name="student-name" required>

                <label for="email">Email Address</label>
                <input type="email" id="email"
                       name="email" required>

                <label for="course">Choose a Course</label>
                <select id="course" name="course" required>
                    <option value="">-- Select a course --</option>
                    <option value="CS101">Introduction to Computing</option>
                    <option value="WD102">Web Development</option>
                    <option value="DB103">Database Management</option>
                    <option value="NT104">Computer Networking</option>
                    <option value="CY105">Cybersecurity Basics</option>
                </select>

                <label for="study-mode">Study Mode</label>
                <select id="study-mode" name="study-mode" required>
                    <option value="">-- Select study mode --</option>
                    <option value="online">Online</option>
                    <option value="physical">Physical Classes</option>
                    <option value="hybrid">Hybrid</option>
                </select>

                <button type="submit">Register Now</button>
            </form>
        </section>

        <section id="campus">
            <h2>Explore Our Learning Environment</h2>
            <img
                src="https://images.unsplash.com/photo-1523050854058-8df90110c9f1?auto=format&fit=crop&w=1000&q=80"
                alt="University campus with students"
                width="800"
                height="450"
                loading="lazy">
            <p>Discover an environment designed to support learning and collaboration.</p>
        </section>

        <section id="video">
            <h2>Introduction to Online Learning</h2>
            <iframe
                width="560"
                height="315"
                src="https://www.youtube-nocookie.com/embed/aircAruvnKk"
                title="Educational video about neural networks"
                loading="lazy"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                referrerpolicy="strict-origin-when-cross-origin"
                allowfullscreen>
            </iframe>
        </section>
    </main>

    <footer>
        <p>&copy; 2026 Campus Course Registration. Learning for the future.</p>
    </footer>

</body>
</html>
